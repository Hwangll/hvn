# Netlify cache rules (Vercel reads vercel.json instead).
# Hashed build output never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Photos and sounds keep their names when replaced, so they stay fresh for a week and revalidate quietly after.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/audio/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
